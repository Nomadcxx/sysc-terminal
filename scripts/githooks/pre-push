#!/bin/sh
# Block pushes whose commits carry tool authorship or attribution, then
# hand the same stdin to git-lfs.

set -eu
input=$(cat)

reject() {
	printf >&2 'ERROR: refusing to push: %s\n' "$1"
	printf >&2 'Rewrite the commit so author, committer and message are human-only.\n'
	exit 1
}

attr_re='cursor|cursoragent|claude|anthropic|chatgpt|openai|copilot|cody|tabnine|codex|gemini|bard|gpt-[0-9]|llm|@cursor\.|generated by|co-authored-by:.*cursor'
zeros=0000000000000000000000000000000000000000

check_one() {
	sha=$1
	meta=$(git log -1 --format='%an%n%ae%n%cn%n%ce%n%B' "$sha")
	if echo "$meta" | grep -qiE "$attr_re"; then
		reject "commit $sha carries tool attribution"
	fi
}

refs=$(mktemp)
trap 'rm -f "$refs"' EXIT
printf '%s\n' "$input" > "$refs"

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -n "${local_sha:-}" ] || continue
	[ "$local_sha" = "$zeros" ] && continue
	if [ -z "${remote_sha:-}" ] || [ "$remote_sha" = "$zeros" ]; then
		revs=$(git rev-list "$local_sha" --not --remotes 2>/dev/null || git rev-list -n 1 "$local_sha")
	else
		revs=$(git rev-list "$remote_sha..$local_sha")
	fi
	for sha in $revs; do
		check_one "$sha"
	done
done < "$refs"

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$input" | git lfs pre-push "$@"
